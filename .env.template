# app/auth/.env.template — reconstruit en app/auth/.env par
# docker-entrypoint.sh au démarrage. envconfiguration.inject: true
# (plugin.yaml) exige que ce fichier existe physiquement, sinon
# ManifestError et le plugin échoue à charger — voir le Dockerfile pour le
# raisonnement complet. Chaque KEY=${KEY} se résout contre la vraie
# variable d'environnement injectée par la plateforme ; absente, elle
# devient une chaîne vide plutôt qu'une erreur (voir plugin.yaml env: —
# les client_id/secret OAuth sont volontairement optionnels : vide =
# provider désactivé).

# Overrides admin seed (optionnels — plugin.yaml seed: est la source par défaut)
ADMIN_EMAIL=${ADMIN_EMAIL}
ADMIN_PASSWORD=${ADMIN_PASSWORD}
ADMIN_TENANT_SLUG=${ADMIN_TENANT_SLUG}
ADMIN_TENANT_NAME=${ADMIN_TENANT_NAME}
ADMIN_ROLE_NAME=${ADMIN_ROLE_NAME}
USER_ROLE_NAME=${USER_ROLE_NAME}

# JWT (optionnels — plugin.yaml jwt: est la source par défaut)
XAUTH_JWT_PRIVATE_KEY_PATH=${XAUTH_JWT_PRIVATE_KEY_PATH}
XAUTH_JWT_PUBLIC_KEY_PATH=${XAUTH_JWT_PUBLIC_KEY_PATH}
XAUTH_JWT_ACCESS_EXPIRE_MINUTES=${XAUTH_JWT_ACCESS_EXPIRE_MINUTES}
XAUTH_JWT_REFRESH_EXPIRE_DAYS=${XAUTH_JWT_REFRESH_EXPIRE_DAYS}

# App / frontend (optionnels — plugin.yaml app: est la source par défaut)
XAUTH_APP_NAME=${XAUTH_APP_NAME}
XAUTH_APP_BASE_URL=${XAUTH_APP_BASE_URL}
XAUTH_WEB_APP_URL=${XAUTH_WEB_APP_URL}

# SMTP — requis pour les emails (réinitialisation mdp, invitations). Ces
# clés existent aussi dans conf/.env.template (même variable d'env des
# deux côtés) — dupliquées ici pour que ce fichier reste complet et
# autoportant, cohérent avec example.env, même si le chargement racine
# suffirait déjà à les résoudre en pratique.
XAUTH_SMTP_HOST=${XAUTH_SMTP_HOST}
XAUTH_SMTP_PORT=${XAUTH_SMTP_PORT}
XAUTH_SMTP_USER=${XAUTH_SMTP_USER}
XAUTH_SMTP_PASSWORD=${XAUTH_SMTP_PASSWORD}
XAUTH_SMTP_FROM=${XAUTH_SMTP_FROM}
XAUTH_SMTP_FROM_NAME=${XAUTH_SMTP_FROM_NAME}
XAUTH_SMTP_USE_TLS=${XAUTH_SMTP_USE_TLS}

# OAuth providers — laisser la variable d'env vide/non injectée désactive
# le provider correspondant, ce n'est pas une erreur.
XAUTH_OAUTH_GOOGLE_CLIENT_ID=${XAUTH_OAUTH_GOOGLE_CLIENT_ID}
XAUTH_OAUTH_GOOGLE_CLIENT_SECRET=${XAUTH_OAUTH_GOOGLE_CLIENT_SECRET}
XAUTH_OAUTH_GITHUB_CLIENT_ID=${XAUTH_OAUTH_GITHUB_CLIENT_ID}
XAUTH_OAUTH_GITHUB_CLIENT_SECRET=${XAUTH_OAUTH_GITHUB_CLIENT_SECRET}
XAUTH_OAUTH_DISCORD_CLIENT_ID=${XAUTH_OAUTH_DISCORD_CLIENT_ID}
XAUTH_OAUTH_DISCORD_CLIENT_SECRET=${XAUTH_OAUTH_DISCORD_CLIENT_SECRET}
XAUTH_OAUTH_MICROSOFT_CLIENT_ID=${XAUTH_OAUTH_MICROSOFT_CLIENT_ID}
XAUTH_OAUTH_MICROSOFT_CLIENT_SECRET=${XAUTH_OAUTH_MICROSOFT_CLIENT_SECRET}
# Clé Fernet (32 octets base64) — sans elle, OAuth fonctionne mais aucun
# jeton Google (Gmail/Calendar) n'est stocké. Générer avec :
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
XAUTH_OAUTH_TOKEN_KEY=${XAUTH_OAUTH_TOKEN_KEY}
XAUTH_OAUTH_WEB_REDIRECT_ORIGINS=${XAUTH_OAUTH_WEB_REDIRECT_ORIGINS}
