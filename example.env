# ─────────────────────────────────────────────────────────────────────────────
# xauth — variables d'environnement (secrets uniquement)
#
# Les valeurs de configuration (seed, jwt, app, rate_limit) sont définies dans
# plugin.yaml. Ce fichier ne contient que les secrets et les overrides optionnels.
#
# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Overrides seed (optionnels — plugin.yaml seed: est la source par défaut) ──
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_TENANT_SLUG=
# ADMIN_TENANT_NAME=
# ADMIN_ROLE_NAME=
# USER_ROLE_NAME=

# ── Overrides JWT (optionnels — plugin.yaml jwt: est la source par défaut) ────
# XAUTH_JWT_PRIVATE_KEY_PATH=conf/private.pem
# XAUTH_JWT_PUBLIC_KEY_PATH=conf/public.pem
# XAUTH_JWT_ACCESS_EXPIRE_MINUTES=15
# XAUTH_JWT_REFRESH_EXPIRE_DAYS=7

# ── App (optionnel — plugin.yaml app: est la source par défaut) ───────────────
# XAUTH_APP_NAME=XAuth
# XAUTH_APP_BASE_URL=http://localhost:8000

# ── SMTP — requis pour les emails (réinitialisation mdp, invitations) ─────────
XAUTH_SMTP_HOST=localhost
XAUTH_SMTP_PORT=587
XAUTH_SMTP_USER=
XAUTH_SMTP_PASSWORD=
XAUTH_SMTP_FROM=noreply@example.com
XAUTH_SMTP_FROM_NAME=XAuth
XAUTH_SMTP_USE_TLS=true

# ── OAuth Providers ────────────────────────────────────────────────────────────
# Laisser vide pour désactiver un provider. Remplir les deux clés pour l'activer.
# Redirect URI : {APP_BASE_URL}/xauth/oauth/{provider}/callback

# Google — https://console.cloud.google.com/apis/credentials
XAUTH_OAUTH_GOOGLE_CLIENT_ID=
XAUTH_OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub — https://github.com/settings/apps
XAUTH_OAUTH_GITHUB_CLIENT_ID=
XAUTH_OAUTH_GITHUB_CLIENT_SECRET=

# Discord — https://discord.com/developers/applications
XAUTH_OAUTH_DISCORD_CLIENT_ID=
XAUTH_OAUTH_DISCORD_CLIENT_SECRET=

# Microsoft / Azure AD — https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
XAUTH_OAUTH_MICROSOFT_CLIENT_ID=
XAUTH_OAUTH_MICROSOFT_CLIENT_SECRET=
